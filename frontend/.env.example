# ============================================================
# ROL AYIRIMI (karıştırmayın)
#   - Yanıt üreten chat LLM  = Nemotron (NVIDIA) → src/api/llm.py
#   - Ragas hakem (judge)    = GPT (OpenAI)     → src/eval/ragas_score.py
# Nemotron ayarına dokunmayın; GPT yalnızca eval skorlamada kullanılır.
# ============================================================

# Frontend → backend adresi (trailing slash yok)
# Tanımlı değilse mock yanıtlar kullanılır.
VITE_API_URL=http://localhost:8000

# NVIDIA Integrate API key — chat LLM (Nemotron) bunu kullanır.
# ÖNEMLİ: VITE_ öneki KOYMA (tarayıcıya sızmasın).
NVIDIA_API_KEY=

# OpenAI API key — YALNIZCA Ragas judge (GPT) bunu kullanır.
# Chat akışına hiç dahil değildir.
OPENAI_API_KEY=
